# PMG Cloud Production Environment

# API Keys (comma-separated, fallback khi chưa có groups)
PMG_CLOUD_API_KEYS=your-strong-api-key-here

# Dashboard Admin Account
PMG_CLOUD_DASH_USER=admin
PMG_CLOUD_DASH_PASS=your-strong-password-here

# Optional: Custom retention and refresh intervals
# PMG_CLOUD_RETENTION_DAYS=30
# PMG_CLOUD_MALWARE_REFRESH_INTERVAL=6h
